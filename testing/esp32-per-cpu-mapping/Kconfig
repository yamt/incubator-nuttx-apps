#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config TESTING_ESP32_PER_CPU_MAPPING
	tristate "TESTING_ESP32_PER_CPU_MAPPING"
	default n
	depends on ESP32_SPIRAM
	---help---
		Enable per cpu mapping test

if TESTING_ESP32_PER_CPU_MAPPING

config TESTING_ESP32_PER_CPU_MAPPING_PROGNAME
	string "Program name"
	default "esp32_per_cpu_mapping"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config TESTING_ESP32_PER_CPU_MAPPING_PRIORITY
	int "task priority"
	default 100

config TESTING_ESP32_PER_CPU_MAPPING_STACKSIZE
	int "stack size"
	default DEFAULT_TASK_STACKSIZE

endif
